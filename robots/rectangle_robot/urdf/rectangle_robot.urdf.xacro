<?xml version="1.0"?>
<robot name="rectangle_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="rectangle_robot_properties.xacro" />
  <xacro:include filename="rectangle_robot_gazebo.xacro" />

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="${(m / 12.0) * (y*y + z*z)}" ixy="0.0" ixz="0.0"
               iyy="${(m / 12.0) * (x*x + z*z)}" iyz="0.0"
               izz="${(m / 12.0) * (x*x + y*y)}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="${(m / 12.0) * (3.0*r*r + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${(m / 12.0) * (3.0*r*r + h*h)}" iyz="0.0"
               izz="${(m / 2.0) * r*r}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="${(2.0 / 5.0) * m * r*r}" ixy="0.0" ixz="0.0"
               iyy="${(2.0 / 5.0) * m * r*r}" iyz="0.0"
               izz="${(2.0 / 5.0) * m * r*r}" />
    </inertial>
  </xacro:macro>

  <link name="base_footprint" />

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${car_length} ${car_width} ${car_height}" />
      </geometry>
      <material name="body_blue" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${car_length} ${car_width} ${car_height}" />
      </geometry>
    </collision>
    <xacro:box_inertia m="${car_mass}" x="${car_length}" y="${car_width}" z="${car_height}" />
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 ${car_height / 2.0 + ground_clearance}" rpy="0 0 0" />
  </joint>

  <link name="front_marker_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.01 ${car_width * 0.72} ${car_height * 0.72}" />
      </geometry>
      <material name="amber" />
    </visual>
  </link>

  <joint name="front_marker_joint" type="fixed">
    <parent link="base_link" />
    <child link="front_marker_link" />
    <origin xyz="${car_length / 2.0 + 0.006} 0 0.004" rpy="0 0 0" />
  </joint>

  <link name="top_heading_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${car_length * 0.45} 0.018 0.004" />
      </geometry>
      <material name="white" />
    </visual>
  </link>

  <joint name="top_heading_joint" type="fixed">
    <parent link="base_link" />
    <child link="top_heading_link" />
    <origin xyz="${car_length * 0.18} 0 ${car_height / 2.0 + 0.004}" rpy="0 0 0" />
  </joint>

  <xacro:macro name="wheel" params="prefix y_dir">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="dark_grey" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}" />
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${prefix}_wheel_link" />
      <origin xyz="${wheel_x} ${y_dir * wheel_y} ${-car_height / 2.0 - ground_clearance + wheel_radius}" rpy="${-pi / 2.0} 0 0" />
      <axis xyz="0 0 1" />
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left" y_dir="1" />
  <xacro:wheel prefix="right" y_dir="-1" />

  <xacro:macro name="caster" params="prefix x_dir">
    <link name="${prefix}_caster_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
        <material name="light_grey" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
      </collision>
      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}" />
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link" />
      <child link="${prefix}_caster_link" />
      <origin xyz="${x_dir * car_length * 0.36} 0 ${-car_height / 2.0 - ground_clearance + caster_radius}" rpy="0 0 0" />
    </joint>
  </xacro:macro>

  <xacro:caster prefix="front" x_dir="1" />
  <xacro:caster prefix="back" x_dir="-1" />
</robot>
