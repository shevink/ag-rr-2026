<?xml version="1.0"?>
<robot name="disc_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include properties and gazebo macros -->
  <xacro:include filename="disc_robot_properties.xacro" />
  <xacro:include filename="disc_robot_gazebo.xacro" />

  <!-- Helper Inertia Macros -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="${(m/12.0) * (3.0*r*r + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12.0) * (3.0*r*r + h*h)}" iyz="0.0"
               izz="${(m/2.0) * (r*r)}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="${(2.0/5.0) * m * r * r}" ixy="0.0" ixz="0.0"
               iyy="${(2.0/5.0) * m * r * r}" iyz="0.0"
               izz="${(2.0/5.0) * m * r * r}" />
    </inertial>
  </xacro:macro>



  <!-- base_footprint standard ROS reference frame on the ground below the robot center -->
  <link name="base_footprint" />

  <!-- base_link main cylinder body of the vacuum cleaner robot -->
  <link name="base_link">
    <!-- Visual representation of the robot body -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${robot_radius}" length="${robot_height}" />
      </geometry>
      <material name="dark_grey" />
    </visual>

    <!-- Collision geometry -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${robot_radius}" length="${robot_height}" />
      </geometry>
    </collision>

    <!-- Inertial properties -->
    <xacro:cylinder_inertia m="${robot_mass}" r="${robot_radius}" h="${robot_height}" />
  </link>

  <!-- Joint connecting base_footprint to base_link -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <!-- Raised by ground_clearance so bottom does not scrape the ground -->
    <origin xyz="0 0 ${robot_height / 2.0 + ground_clearance}" rpy="0 0 0" />
  </joint>

  <!-- Aesthetic accents & bunny ears -->
  
  <!-- LED Ring on top of the robot -->
  <link name="led_ring_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${robot_radius * 0.85}" length="0.002" />
      </geometry>
      <material name="electric_blue" />
    </visual>
  </link>

  <joint name="led_ring_joint" type="fixed">
    <parent link="base_link" />
    <child link="led_ring_link" />
    <!-- Positioned just on top of the base cylinder -->
    <origin xyz="0 0 ${robot_height / 2.0 + 0.001}" rpy="0 0 0" />
  </joint>

  <!-- Heading indicator (Forward direction pointer) -->
  <link name="heading_indicator_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${robot_radius * 0.3} 0.015 0.002" />
      </geometry>
      <material name="amber" />
    </visual>
  </link>

  <joint name="heading_indicator_joint" type="fixed">
    <parent link="base_link" />
    <child link="heading_indicator_link" />
    <!-- Positioned on the front edge pointing along the x-axis -->
    <origin xyz="${robot_radius * 0.7} 0 ${robot_height / 2.0 + 0.002}" rpy="0 0 0" />
  </joint>

  <!-- Virtual lidar frame used by camera_based_lidar node output -->
  <link name="lidar_front_link" />

  <joint name="base_footprint_to_lidar_front_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="lidar_front_link" />
    <origin xyz="0.10 0 0" rpy="0 0 0" />
  </joint>

  <!-- Camera system (ported from racer) -->
  <link name="ipm_ground_virtuallink" />

  <joint name="base_footprint_to_ipm_ground_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="ipm_ground_virtuallink" />
    <origin xyz="0.10 0 0" rpy="0 0 0" />
  </joint>

  <link name="camera_stack_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${camera_stack_length} ${camera_stack_width} ${camera_stack_height}" />
      </geometry>
      <material name="dark_grey" />
    </visual>
  </link>

  <joint name="base_link_to_camera_stack_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_stack_link" />
    <origin xyz="${robot_radius * 0.5} 0 ${robot_height / 2.0}" rpy="0 0 0" />
  </joint>

  <link name="camera_high_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${camera_length} ${camera_width} ${camera_height}" />
      </geometry>
      <material name="black" />
    </visual>
  </link>

  <joint name="camera_stack_to_camera_high_joint" type="fixed">
    <parent link="camera_stack_link" />
    <child link="camera_high_link" />
    <origin
      xyz="${(camera_stack_length / 2.0) + (camera_length / 2.0)} 0 ${camera_high_ground_height - (robot_height + ground_clearance + camera_stack_height)}"
      rpy="0 0.50 0" />
  </joint>

  <!-- Drive Wheels -->
  <xacro:macro name="wheel" params="prefix y_dir">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="light_grey" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}" />
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${prefix}_wheel_link" />
      <!-- Positioned on the side, and lowered so it touches the ground -->
      <origin xyz="0 ${y_dir * wheel_yg} ${-robot_height / 2.0 - ground_clearance + wheel_radius}" rpy="${-pi/2} 0 0" />
      <axis xyz="0 0 1" />
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left" y_dir="1" />
  <xacro:wheel prefix="right" y_dir="-1" />

  <!-- Caster Wheels -->
  <xacro:macro name="caster" params="prefix x_dir">
    <link name="${prefix}_caster_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
        <material name="light_grey" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
      </collision>
      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}" />
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link" />
      <child link="${prefix}_caster_link" />
      <!-- Positioned at front/back along x-axis, at the bottom of the body cylinder -->
      <origin xyz="${x_dir * 0.075} 0 ${-robot_height / 2.0 - ground_clearance + caster_radius}" rpy="0 0 0" />
    </joint>
  </xacro:macro>

  <xacro:caster prefix="front" x_dir="1" />
  <xacro:caster prefix="back" x_dir="-1" />

</robot>
