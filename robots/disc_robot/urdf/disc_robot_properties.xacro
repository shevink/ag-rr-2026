<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--materials-->
  <material name="dark_grey">
    <color rgba="0.15 0.15 0.15 1.0" />
  </material>

  <material name="light_grey">
    <color rgba="0.8 0.8 0.8 1.0" />
  </material>

  <material name="electric_blue">
    <color rgba="0.0 0.5 1.0 1.0" />
  </material>

  <material name="amber">
    <color rgba="1.0 0.6 0.0 1.0" />
  </material>

  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0" />
  </material>

  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0" />
  </material>

  <!-- Robot Body Properties -->
  <xacro:property name="robot_radius" value="0.10" />
  <xacro:property name="robot_height" value="0.05" />
  <xacro:property name="robot_mass" value="2.0" />

  <!-- Wheel Properties -->
  <xacro:property name="wheel_radius" value="0.02" />
  <xacro:property name="wheel_width" value="0.01" />
  <xacro:property name="wheel_mass" value="0.05" />
  <xacro:property name="wheel_yg" value="0.09" />
  
  <!-- Caster properties -->
  <xacro:property name="caster_radius" value="0.015" />
  <xacro:property name="caster_mass" value="0.02" />
  <xacro:property name="ground_clearance" value="0.015" />

  <!-- Camera properties -->
  <xacro:property name="camera_hz" value="30" />
  <xacro:property name="camera_fov" value="1.089" />
  <xacro:property name="camera_resolution_width" value="640" />
  <xacro:property name="camera_resolution_height" value="480" />
  <xacro:property name="camera_high_ground_height" value="0.20" />
  <xacro:property name="camera_length" value="0.025" />
  <xacro:property name="camera_width" value="0.05" />
  <xacro:property name="camera_height" value="0.02" />
  <xacro:property name="camera_weight" value="0.005" />
  <xacro:property name="camera_stack_length" value="0.015" />
  <xacro:property name="camera_stack_width" value="0.04" />
  <xacro:property name="camera_stack_height" value="0.04" />
  <xacro:property name="camera_stack_weight" value="0.02" />
</robot>
