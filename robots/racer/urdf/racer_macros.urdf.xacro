<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!--macros-->

    <xacro:macro name="cylinder" params="name radius height weight=0 color=blue-green">
        <link name="${name}_link">
            <visual>
                <geometry>
                    <cylinder radius="${radius}" length="${height}" />
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <material name="${color}" />
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${radius}" />
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0" />
            </collision>
            <xacro:cylinder_inertia m="${weight}" r="${radius}" h="${height}" o_xyz="0 0 0"
                o_rpy="0 0 0" />
        </link>
    </xacro:macro>

    <xacro:macro name="wheel" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
                <material name="black" />
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${wheel_radius}" />
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0" />
            </collision>
            <xacro:cylinder_inertia m="${wheel_weight}" r="${wheel_radius}" h="${wheel_width}" o_xyz="0 0 0"
                o_rpy="${pi / 2.0} 0 0" />
        </link>
        <gazebo reference="${prefix}_wheel_link">
            <mu1>1.5</mu1> <mu2>1.5</mu2> <kp>1000000.0</kp> <kd>10.0</kd>      <minDepth>0.001</minDepth>
            <maxVel>0.1</maxVel>
            <fdir1>1 0 0</fdir1> <material>Gazebo/Black</material>
        </gazebo>
    </xacro:macro>

    <xacro:macro name="axis" params="prefix">
        <link name="${prefix}_axis_link">
            <visual>
                <geometry>
                    <cylinder radius="${axis_radius}" length="${axis_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
                <material name="dark" />
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${axis_radius}" />
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0" />
            </collision>
            <xacro:cylinder_inertia m="${axis_weight}" r="${axis_radius}" h="${axis_length}" o_xyz="0 0 0"
                o_rpy="${pi / 2.0} 0 0" />
        </link>
    </xacro:macro>

    <xacro:macro name="box" params="name length width height weight=0 color=blue-green">
        <link name="${name}_link">
            <visual>
                <geometry>
                    <box
                        size="${length} ${width} ${height}" />
                </geometry>
                <origin xyz="0 0 ${height / 2.0}" rpy="0 0 0" />
                <material name="${color}" />
            </visual>
            <collision>
                <geometry>
                    <box
                        size="${length} ${width} ${height}" />
                </geometry>
                <origin xyz="0 0 ${height / 2.0}" rpy="0 0 0" />
            </collision>
            <xacro:box_inertia m="${weight}" x="${length}" y="${width}"
                z="${height}" o_xyz="0 0 ${height / 2.0}"
                o_rpy="0 0 0" />
        </link>
    </xacro:macro>

    <xacro:macro name="front_steering_mount" params="position">
        <link name="front_${position}_steering_link">
            <inertial>
                <mass value="0.001" />
                <origin xyz="0 0 0" rpy="0 0 0" />
                <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001" />
            </inertial>
        </link>
    </xacro:macro>


    <xacro:macro name="box_inertia" params="m x y z o_xyz o_rpy">
    <inertial>
    <!--https://en.wikipedia.org/wiki/List_of_moments_of_inertia-->
      <mass value="${m}"/>
      <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
      <inertia ixx="${(m/12) * (y*y + z*z)}" ixy="0" ixz="0"
               iyy="${(m/12) * (x*x + z*z)}" iyz="0"
               izz="${(m/12) * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h o_xyz o_rpy">
    <inertial>
    <!--https://en.wikipedia.org/wiki/List_of_moments_of_inertia-->
      <mass value="${m}"/>
      <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0" ixz="0"
               iyy="${(m/12) * (3*r*r + h*h)}" iyz="0"
               izz="${(m/2) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r o_xyz o_rpy">
    <inertial>
    <!--https://en.wikipedia.org/wiki/List_of_moments_of_inertia-->
      <mass value="${m}"/>
      <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
      <inertia ixx="${(2/5)*m*r*r}" ixy="0" ixz="0"
               iyy="${(2/5)*m*r*r}" iyz="0"
               izz="${(2/5)*m*r*r}"/>
    </inertial>
  </xacro:macro>

    <xacro:macro name="gazebo_camera" params="link_name topic_name sensor_name:=camera">
        <gazebo reference="${link_name}">
            <sensor name="${sensor_name}" type="camera">
                <update_rate>${camera_hz}</update_rate> <topic>${topic_name}</topic>
                <gz_frame_id>${link_name}</gz_frame_id> <camera>
                    <horizontal_fov>${camera_fov}</horizontal_fov> <image>
                        <width>${camera_resolution_width}</width> <height>${camera_resolution_height}</height> <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.05</near>
                        <far>8.0</far>
                    </clip>
                </camera>
            </sensor>
        </gazebo>
    </xacro:macro>

  <xacro:macro name="imu_sensor_virtual" params="name parent_link xyz rpy topic:=/model/racer/imu">
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent_link}" />
      <child link="${name}_link" />
      <origin xyz="${xyz}" rpy="${rpy}" />
    </joint>

    <link name="${name}_link">
      </link>

    <gazebo reference="${name}_link">
      <sensor name="${name}" type="imu">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <topic>${topic}</topic>
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="gazebo_lidar" params="link_name topic_name update_rate samples min_angle max_angle range_min range_max">
    <gazebo reference="${link_name}">
        <sensor name="${link_name}_sensor" type="gpu_lidar">
            <topic>${topic_name}</topic>
            <always_on>true</always_on>
            <update_rate>${update_rate}</update_rate>
            <visualize>true</visualize>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>${samples}</samples>
                        <resolution>1</resolution>
                        <min_angle>${min_angle}</min_angle>
                        <max_angle>${max_angle}</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>${range_min}</min>
                    <max>${range_max}</max>
                    <resolution>0.01</resolution>
                </range>
            </lidar>
        </sensor>
    </gazebo>
</xacro:macro>

  
</robot>