<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo>
        <plugin
            filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
            <left_joint>back_left_wheel_joint</left_joint>
            <right_joint>back_right_wheel_joint</right_joint>
            <left_steering_joint>front_left_steering_joint</left_steering_joint>
            <right_steering_joint>front_right_steering_joint</right_steering_joint>
            <wheel_separation>0.153</wheel_separation>
            <kingpin_width>0.128</kingpin_width>
            <wheel_radius>0.0325</wheel_radius>
            <frame_id>racer/odom</frame_id>
            <child_frame_id>racer/base_footprint</child_frame_id>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <joint_name>back_left_wheel_joint</joint_name>
            <joint_name>back_right_wheel_joint</joint_name>
            <joint_name>front_left_steering_joint</joint_name>
            <joint_name>front_right_steering_joint</joint_name>
            <joint_name>front_left_wheel_joint</joint_name>
            <joint_name>front_right_wheel_joint</joint_name>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
            <publish_link_pose>false</publish_link_pose>
            <publish_model_pose>true</publish_model_pose>
            <publish_nested_models>false</publish_nested_models>
            <use_pose_vector_msg>true</use_pose_vector_msg>
            <update_frequency>50</update_frequency>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
        </plugin>
    </gazebo>

    <xacro:gazebo_camera link_name="camera_high_link" topic_name="/model/racer/camera_high/image_raw" sensor_name="camera_high" />

    <gazebo>
        <plugin
            filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
    </gazebo>

    <xacro:gazebo_lidar 
        link_name="lidar_front_link" 
        topic_name="/model/racer/lidar_front/scan" 
        update_rate="${lidar_update_rate}"
        samples="${lidar_samples}"
        min_angle="0.0"
        max_angle="6.28319"
        range_min="${lidar_range_min}"
        range_max="${lidar_range_max}" />

    <xacro:gazebo_lidar 
        link_name="lidar_back_link" 
        topic_name="/model/racer/lidar_back/scan" 
        update_rate="10"
        samples="5"
        min_angle="3.13"
        max_angle="3.15"
        range_min="0.2"
        range_max="8.0" />

</robot>
