<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="name" default="obstacle" />
  <xacro:arg name="static" default="false" />

  <xacro:unless value="$(arg static)">
    <gazebo>
      <!-- Direct velocity control (twist on /cmd_vel) -->
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/$(arg name)/cmd_vel</topic>
      </plugin>

      <!-- Ground-truth pose publisher -->
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <publish_nested_models>false</publish_nested_models>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>30</update_frequency>
      </plugin>
    </gazebo>
  </xacro:unless>

  <xacro:if value="$(arg static)">
    <gazebo>
      <static>true</static>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <publish_nested_models>false</publish_nested_models>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>30</update_frequency>
      </plugin>
    </gazebo>
  </xacro:if>

  <gazebo reference="base_link">
    <!-- I don't know if the kinematic tag does anything. It's intended to make the obstacle
     not be moved by the cars on collision. I have also given the obstacle a large mass as a fallback. -->
    <kinematic>true</kinematic>
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
    <xacro:unless value="$(arg static)">
      <visual>
        <material>
          <ambient>1.0 0.4 0.0 1.0</ambient>
          <diffuse>1.0 0.4 0.0 1.0</diffuse>
          <specular>0.5 0.5 0.5 1.0</specular>
        </material>
      </visual>
    </xacro:unless>
    <xacro:if value="$(arg static)">
      <visual>
        <material>
          <ambient>0.5 0.5 0.5 1.0</ambient>
          <diffuse>0.5 0.5 0.5 1.0</diffuse>
          <specular>0.3 0.3 0.3 1.0</specular>
        </material>
      </visual>
    </xacro:if>
  </gazebo>

</robot>
