<?xml version="1.0"?>
<robot name="obstacle" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="obstacle_properties.xacro" />
  <xacro:include filename="obstacle_gazebo.xacro" />

  <link name="base_footprint" />

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${cube_size} ${cube_size} ${cube_size}" />
      </geometry>
      <material name="orange" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${cube_size} ${cube_size} ${cube_size}" />
      </geometry>
    </collision>
    <inertial>
      <mass value="${cube_mass}" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia
        ixx="${(cube_mass / 6.0) * cube_size * cube_size}" ixy="0" ixz="0"
        iyy="${(cube_mass / 6.0) * cube_size * cube_size}" iyz="0"
        izz="${(cube_mass / 6.0) * cube_size * cube_size}" />
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 ${cube_size / 2.0}" rpy="0 0 0" />
  </joint>

</robot>
